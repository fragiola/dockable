{
    "name": "dockable",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "packageManager": "pnpm@11.23.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "scripts": {
        "format": "biome format --write",
        "lint": "biome lint",
        "check": "biome check && pnpm --filter @fragiola/dockable check:interfaces",
        "check:fix": "biome check --write",
        "typecheck": "pnpm -r typecheck",
        "test": "vitest run",
        "build": "pnpm -r build",
        "e2e": "pnpm --workspace-concurrency=1 --filter playground --filter docs e2e",
        "dev": "pnpm --filter playground dev",
        "docs:dev": "pnpm --filter docs dev"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "vitest": "4.1.11"
    }
}
