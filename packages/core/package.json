{
    "name": "@fragiola/dockable",
    "version": "0.0.0",
    "description": "Headless layout manager for dockable panels: a typed state model with a command bus, the layout engine, drag and drop, popouts.",
    "keywords": [
        "layout",
        "docking",
        "dock",
        "tabs",
        "splitter",
        "panels",
        "headless",
        "drag-and-drop"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/dockable.git",
        "directory": "packages/core"
    },
    "homepage": "https://fragiola.com/dockable",
    "bugs": {
        "url": "https://github.com/fragiola/dockable/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "generate:commands": "tsdown && node scripts/generate-command-docs.ts"
    },
    "devDependencies": {
        "jsdom": "30.0.1",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vitest": "4.1.11",
        "vite": "8.3.0"
    }
}
