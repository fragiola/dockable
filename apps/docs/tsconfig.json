{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "customConditions": ["development"],
        "allowJs": true,
        "incremental": true,
        "plugins": [{ "name": "next" }],
        "paths": {
            "@/*": ["./*"]
        },
        "types": ["node"]
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules", ".next", "out"]
}
