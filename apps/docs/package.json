{
    "name": "docs",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "node scripts/build-examples.ts",
        "dev": "next dev --port 3000",
        "prebuild": "node scripts/build-examples.ts",
        "build": "next build",
        "serve": "node scripts/serve-static.ts",
        "typecheck": "node scripts/build-examples.ts && fumadocs-mdx && tsc --noEmit",
        "test": "vitest run",
        "e2e": "playwright test",
        "vendor": "node scripts/vendor-fragiola.ts"
    },
    "dependencies": {
        "@base-ui/react": "1.7.0",
        "@fragiola/dockable": "workspace:*",
        "@fragiola/dockable-react": "workspace:*",
        "clsx": "2.1.1",
        "echarts": "6.1.0",
        "echarts-for-react": "3.0.6",
        "fumadocs-core": "16.14.5",
        "fumadocs-mdx": "15.3.0",
        "fumadocs-ui": "16.14.5",
        "lucide-react": "1.34.0",
        "next": "16.3.3",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwind-merge": "3.6.0",
        "tailwind-variants": "3.3.1"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@tailwindcss/postcss": "4.3.3",
        "@types/mdx": "2.0.14",
        "@types/node": "24.13.5",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "7.0.2",
        "vitest": "4.1.11"
    }
}
